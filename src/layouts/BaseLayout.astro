---
import 'bootstrap/dist/css/bootstrap.min.css';
import '@fortawesome/fontawesome-free/css/all.min.css';
import 'aos/dist/aos.css';
import '@fontsource/montserrat/latin-400.css';
import '@fontsource/montserrat/latin-700.css';
import '@fontsource/lato/latin-400.css';
import '@fontsource/lato/latin-700.css';
import '@fontsource/lato/latin-400-italic.css';
import '@fontsource/lato/latin-700-italic.css';
import '../styles/global.css';
import '../styles/legacy.css';
import { getContent, type Lang } from '../i18n';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  noindex?: boolean;
}

const {
  title,
  description = 'Asociación CEPROC: desarrollo sostenible y acción comunitaria en Bolivia.',
  lang = 'es',
  noindex = false,
} = Astro.props;
const content = getContent(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip-link" href="#contenido">{content.accessibility.skipLink}</a>
    <slot />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
