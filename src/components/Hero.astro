---
import { Image } from 'astro:assets';
import banner from '../assets/images/img.jpg';
import { getContent, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = getContent(lang);
---

<header id="inicio" class="hero">
  <div class="hero-media">
    <Image
      src={banner}
      alt={content.hero.imageAlt}
      widths={[480, 960, 1280]}
      sizes="100vw"
      loading="eager"
    />
  </div>
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="hero-content">
    <div class="container">
      <h1>{content.hero.title}</h1>
      <p>{content.hero.text}</p>
      <a href="#contacto" class="btn btn-contact-principal hero-cta">{content.hero.cta}</a>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 600px;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
  }

  .hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(47, 58, 41, 0.72) 0%, rgba(47, 58, 41, 0.35) 55%, rgba(47, 58, 41, 0.12) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 7rem 0 4rem;
    color: #fff;
    text-align: center;
  }

  .hero-content :global(.container) {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .hero-content h1 {
    margin-bottom: 1rem;
    font-size: clamp(3rem, 8vw, 5rem);
    letter-spacing: 0.08em;
  }

  .hero-content p {
    max-width: 42rem;
    margin: 0 auto 2rem;
    font-size: clamp(1rem, 2vw, 1.25rem);
  }

  .hero-content .hero-cta {
    position: static;
    transform: none;
  }

  @media (max-width: 767.98px) {
    .hero {
      min-height: 720px;
    }

    .hero-content {
      padding-top: 8rem;
    }
  }
</style>
