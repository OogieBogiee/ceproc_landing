---
import { Image } from 'astro:assets';
import slideOne from '../assets/images/img.jpg';
import slideTwo from '../assets/images/img2.jpg';
import slideThree from '../assets/images/img3.jpg';
import { getContent, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = getContent(lang);
const slides = [slideOne, slideTwo, slideThree];
---

<header id="inicio">
  <div id="heroCarousel" class="carousel carousel-dark slide carousel-top" data-bs-ride="carousel">
    <div class="carousel-indicators">
      {slides.map((_, index) => (
        <button
          type="button"
          data-bs-target="#heroCarousel"
          data-bs-slide-to={index}
          class:list={[{ active: index === 0 }]}
          aria-current={index === 0 ? 'true' : undefined}
          aria-label={`${content.hero.slideLabel} ${index + 1}`}
        />
      ))}
    </div>
    <div class="carousel-inner">
      {slides.map((slide, index) => (
        <div class:list={['carousel-item', { active: index === 0 }]} data-bs-interval="8000">
          <Image
            src={slide}
            alt={content.hero.slides[index].alt}
            widths={[640, 960, 1280]}
            sizes="100vw"
            class="d-block w-100"
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
          />
        </div>
      ))}
    </div>
    <div class="image-caption">
      <div class="caption-medium">
        <span class="ml12">{content.hero.captions.intro}</span>
      </div>
      <div class="caption-large">
        <span class="ml12">{content.hero.captions.title}</span>
      </div>
      <p class="visually-hidden">
        {content.hero.captions.line1} {content.hero.captions.line2}
      </p>
      <div id="typing-container" class="caption-small" aria-hidden="true">
        <span id="line1">{content.hero.captions.line1}</span>
        <p>
          <span id="line2">{content.hero.captions.line2}</span>
        </p>
      </div>
      <a href="#contacto" class="btn btn-contact-principal">{content.hero.cta}</a>
    </div>
  </div>
</header>

<style>
  @media (min-width: 1200px) {
    .carousel-item :global(img) {
      height: auto;
    }
  }
</style>
