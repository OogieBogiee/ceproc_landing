---
import { Image } from 'astro:assets';
import boliviaMap from '../assets/images/bolivia.png';
import { getContent, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = getContent(lang);
const { scope } = content;
---

<article class="alcance">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6 col-md-12 mb-4 mb-lg-0">
        <div data-aos="zoom-in" data-aos-duration="1000" class="image-wrapper">
          <Image
            src={boliviaMap}
            alt={scope.imageAlt}
            widths={[306, 612]}
            sizes="(max-width: 991px) 100vw, 50vw"
            class="img-fluid"
            loading="lazy"
          />
        </div>
      </div>
      <div class="col-lg-6 col-md-12">
        <div class="descripcion_derecha">
          <h2 data-aos="zoom-in-up" data-aos-duration="1000" class="descripcion_titulo text-uppercase">
            {scope.title}
          </h2>
          {scope.paragraphs.map((paragraph) => (
            <p data-aos="zoom-in-up" data-aos-duration="1100">{paragraph}</p>
          ))}
        </div>
      </div>
    </div>
  </div>
</article>
