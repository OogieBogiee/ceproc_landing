---
import { getContent, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = getContent(lang);
const { about } = content;
---

<article class="acerca">
  <div class="container">
    <h1 data-aos="fade-up" data-aos-duration="800" class="acerca-heading text-uppercase mb-0">
      {about.title}
    </h1>
    <div class="row justify-content-center">
      <div class="col-lg-8 col-xl-7">
        <p data-aos="fade-up" data-aos-duration="1000" class="acerca-text">{about.text}</p>
      </div>
      <div class="mision-vision">
        <div class="mision">
          <h2 data-aos="fade-up" data-aos-duration="1800">{about.mission.title}</h2>
          <p data-aos="fade-up" data-aos-duration="1900">{about.mission.text}</p>
        </div>
        <div class="vision">
          <h2 data-aos="fade-up" data-aos-duration="1800">{about.vision.title}</h2>
          <p data-aos="fade-up" data-aos-duration="1900">{about.vision.text}</p>
        </div>
      </div>
    </div>
  </div>
</article>
