---
import { getContent, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = getContent(lang);
const { disciplines } = content;
const ids = ['One', 'Two', 'Three', 'Four', 'Five'];
---

<article class="disciplinas">
  <div class="container">
    <h2 data-aos="fade-up" data-aos-duration="800" class="disciplinas-heading text-center text-uppercase mb-0">
      {disciplines.title}
    </h2>
    <div class="row justify-content-center">
      <div class="col-lg-8 col-xl-7">
        <p data-aos="fade-up" data-aos-duration="1000" class="disciplinas-text">
          {disciplines.intro}
        </p>
      </div>
    </div>
    <div id="accordionFlushExample">
      <div class="row justify-content-center">
        {disciplines.items.map((item, index) => (
          <div class="col-lg-4">
            <div class="card">
              <div class="header" data-aos="zoom-in-up" data-aos-duration={item.duration}>
                <div class={`icon ${item.iconClass}`}>
                  <i class={`fa-solid ${item.icon}`} aria-hidden="true"></i>
                </div>
              </div>
              <div class="body">
                <div class="accordion-item">
                  <h2 class="accordion-header" id={`flush-heading${ids[index]}`}>
                    <button
                      class="accordion-button collapsed"
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target={`#collapse${ids[index]}`}
                      aria-expanded="false"
                      aria-controls={`collapse${ids[index]}`}
                    >
                      <span class="titulo-wrapper">
                        <span class="titulo">{item.title}</span>
                      </span>
                    </button>
                  </h2>
                  <div
                    id={`collapse${ids[index]}`}
                    class="accordion-collapse collapse"
                    aria-labelledby={`flush-heading${ids[index]}`}
                    data-bs-parent="#accordionFlushExample"
                  >
                    <div class="accordion-body">
                      <p class="contenido">{item.text}</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</article>

<style>
  .icon {
    font-size: 45px;
  }

  .titulo {
    display: block;
    margin-bottom: 0.5rem;
    font-family: "Montserrat", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
  }
</style>
