---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import { getContent, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = getContent(lang);
---

<nav class="navbar navbar-expand-lg text-uppercase fixed-top shadow-bottom" id="mainNav">
  <div class="container">
    <a class="navbar-brand" href="#inicio" aria-label={content.nav.homeLabel}>
      <Image
        src={logo}
        alt={content.nav.logoAlt}
        width={90}
        height={80}
        loading="eager"
      />
    </a>
    <button
      class="navbar-toggler text-uppercase font-weight-bold rounded"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarResponsive"
      aria-controls="navbarResponsive"
      aria-expanded="false"
      aria-label={content.nav.menuLabel}
      data-label-menu={content.nav.menuLabel}
      data-label-close={content.nav.closeLabel}
    >
      <span class="navbar-toggler-label">{content.nav.menuLabel}</span>
      <i class="fas fa-bars" aria-hidden="true"></i>
    </button>
    <div class="collapse navbar-collapse" id="navbarResponsive">
      <ul class="navbar-nav ms-auto">
        {content.nav.links.map((link) => (
          <li class="nav-item mx-0 mx-lg-1">
            <a class="nav-link py-3 px-0 px-lg-3 rounded" href={link.href}>
              <i class={`fa-solid ${link.icon}`} aria-hidden="true"></i>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</nav>

<style is:global>
  @media (max-width: 991.98px) {
    #mainNav .navbar-nav li.nav-item a.nav-link:not(.active) {
      color: #485342;
    }

    #mainNav .navbar-nav li.nav-item a.nav-link:not(.active):hover {
      color: #2f3a29;
    }
  }
</style>
